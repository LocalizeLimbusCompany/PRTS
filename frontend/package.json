{
  "name": "prts-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PRTS 前端 · Vue 3 + Quasar",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json,css,scss}\""
  },
  "dependencies": {
    "@quasar/extras": "^1.16.0",
    "axios": "^1.7.0",
    "pinia": "^2.2.0",
    "quasar": "^2.17.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/vite-plugin": "^1.8.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.0",
    "sass-embedded": "^1.80.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
