# ===== PRTS 环境变量示例 =====
# 复制为 .env 后按需修改。切勿提交真实密钥（.env 已在 .gitignore 中）。
# 后端配置键遵循 config 分层：前缀 PRTS__，分隔符 __（见 backend/config/default.toml）。

# --- 宿主机端口映射（docker compose）---
# 默认 8080 / 3000 被占用时，改这里即可（容器内部端口不变）。
FRONTEND_PORT=8080
BACKEND_PORT=3000

# --- 后端 HTTP（容器内部）---
PRTS__SERVER__HOST=0.0.0.0
PRTS__SERVER__PORT=3000

# --- PostgreSQL（compose 内服务名为 postgres）---
POSTGRES_MIGRATION_USER=prts_migrator
POSTGRES_MIGRATION_PASSWORD=dev-migrator-change-me
POSTGRES_RUNTIME_USER=prts_runtime
POSTGRES_RUNTIME_PASSWORD=dev-runtime-change-me
POSTGRES_DB=prts
PRTS__DATABASE__URL=postgres://prts_runtime:dev-runtime-change-me@postgres:5432/prts
PRTS__DATABASE__MIGRATION_URL=postgres://prts_migrator:dev-migrator-change-me@postgres:5432/prts
PRTS__DATABASE__RUNTIME_ROLE=prts_runtime
PRTS__DATABASE__MAX_CONNECTIONS=10

# --- Redis（compose 内服务名为 redis）---
PRTS__REDIS__URL=redis://redis:6379

# --- 日志 ---
RUST_LOG=info,sqlx=warn
# 设为 json 可输出结构化日志，便于生产采集
PRTS_LOG_FORMAT=text

# --- 认证（P1）---
# JWT 签名密钥（HS256）。生产务必改为强随机值！
PRTS__AUTH__JWT_SECRET=dev-insecure-change-me
PRTS__AUTH__ACCESS_TTL_SECS=900
PRTS__AUTH__REFRESH_TTL_SECS=2592000
# 对外基础地址（OAuth 回调与登录后跳转用），生产填真实域名如 https://prts.zeroasso.top
PRTS__AUTH__PUBLIC_BASE_URL=http://localhost:8080
# 启动时把该用户名提升为 super_admin（可空）
PRTS__AUTH__BOOTSTRAP_ADMIN=

# --- ZOOT OAuth（P1，CLIENT_ID 留空则不启用 ZOOT 登录）---
PRTS__AUTH__ZOOT__CLIENT_ID=
PRTS__AUTH__ZOOT__CLIENT_SECRET=
PRTS__AUTH__ZOOT__AUTHORIZE_URL=https://zoot.example.com/oauth/authorize
PRTS__AUTH__ZOOT__TOKEN_URL=https://zoot.example.com/oauth/token
PRTS__AUTH__ZOOT__USERINFO_URL=https://zoot.example.com/oauth/userinfo

# --- 向量化（P4，可选，默认关闭；开关与模型/URL 在管理后台配置）---
# 向量化（可选，默认关闭；开关与模型/URL 在管理后台配置）。仅密钥经 env：
PRTS__EMBEDDING__QWEN__API_KEY=
# 向量维度须与迁移 0004 vector(1024) 一致，一般不改；如需覆盖再取消注释：
# PRTS__EMBEDDING__QWEN__DIMENSIONS=1024
